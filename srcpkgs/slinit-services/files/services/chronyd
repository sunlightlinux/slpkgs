# chronyd -- keeps the clock right (slinit-services). A server with a
# drifting clock has logs that disagree and TLS that fails, the daily system
# update's included. Started by boot, and skipped where chrony is not
# installed. Same invocation as Void's runit service. dhcpcd returns before it
# has a lease; chronyd keeps trying its pool until the network is up.
type = process
command = /usr/bin/chronyd -n -u chrony
condition-path-exists = /usr/bin/chronyd
pre-start-command = /usr/bin/install -d -m750 -o chrony -g chrony /var/run/chrony
depends-on: misc
waits-for: network
restart = true

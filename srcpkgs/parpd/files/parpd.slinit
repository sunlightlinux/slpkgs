# parpd -- proxy ARP daemon (parpd). Not started by default; enable with:
# slinitctl enable parpd
# Options: OPTS in /etc/conf.d/parpd (default -fl); the daemon's own
# configuration stays /etc/parpd.conf.
type = process
command = /usr/libexec/slinit/parpd
depends-on: network.target
restart = true
log-type = journal

#!/bin/sh
# The limits and modules of Void's runit service. Options: OPTS in
# /etc/conf.d/docker (Void's runit conf moved there).
set -u
OPTS=
[ -r /etc/conf.d/docker ] && . /etc/conf.d/docker
/usr/bin/modprobe -q loop 2>/dev/null
/usr/bin/modprobe -q br_netfilter 2>/dev/null
ulimit -n 1048576 2>/dev/null
ulimit -u 1048576 2>/dev/null
exec /usr/bin/dockerd --containerd=/run/containerd/containerd.sock ${OPTS}

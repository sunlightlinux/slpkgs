# vmware-vmblock-fuse -- VMware drag-and-drop block filesystem at
# /run/vmblock-fuse (open-vm-tools). Not started by default; enable with:
# slinitctl enable vmware-vmblock-fuse
type = process
command = /usr/bin/vmware-vmblock-fuse -d -f -o subtype=vmware-vmblock,default_permissions,allow_other /run/vmblock-fuse
pre-start-command = /usr/bin/mkdir -p /run/vmblock-fuse
depends-on: local.target
restart = true
log-type = journal

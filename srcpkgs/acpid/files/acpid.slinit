# acpid -- acts on the power button (acpid). Started by default (vslinit
# enable): without it a power button, or a hypervisor's shutdown request
# without a guest agent, does nothing; measured, a VM was still running 25 s
# after system_powerdown. Same invocation as Void's runit service.
type = process
command = /usr/bin/acpid -f -l
depends-on: local.target
restart = true

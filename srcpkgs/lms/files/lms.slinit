# lms -- Lightweight Music Server (lms). Not started by default; enable
# with: slinitctl enable lms
# Options: LMSUSER, WORKDIR and OPTS in /etc/conf.d/lms. The helper runs
# as root, as the user and directory are read from that file, changes to
# WORKDIR and drops to that user through setpriv.
type = process
command = /usr/libexec/slinit/lms
depends-on: network.target
restart = true
log-type = journal

# earlyoom -- kills the largest process before the system runs out of
# memory (earlyoom). Not started by default; enable with:
#     slinitctl enable earlyoom
# Options: OPTS in /etc/conf.d/earlyoom.
type = process
command = /usr/libexec/slinit/earlyoom
depends-on: local.target
restart = true
log-type = journal

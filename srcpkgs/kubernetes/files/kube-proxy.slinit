# kube-proxy -- Kubernetes network proxy (kubernetes).
# Not started by default; enable with: slinitctl enable kube-proxy
# Options: /etc/kubernetes/config and /etc/kubernetes/proxy.
type = process
command = /usr/libexec/slinit/kube-proxy
depends-on: network.target
restart = true
# Output: stdout goes to the journal; stderr is discarded, as the
# runit run script discarded it.
log-type = journal

#!/bin/sh
# Void's runit run script.
set -u
KUBE_LOGTOSTDERR=
KUBE_LOG_LEVEL=
KUBE_MASTER=
KUBE_PROXY_ARGS=
[ -r /etc/kubernetes/config ] && . /etc/kubernetes/config
[ -r /etc/kubernetes/proxy ] && . /etc/kubernetes/proxy
exec /usr/bin/kube-proxy \
	$KUBE_LOGTOSTDERR \
	$KUBE_LOG_LEVEL \
	$KUBE_MASTER \
	$KUBE_PROXY_ARGS 2>/dev/null

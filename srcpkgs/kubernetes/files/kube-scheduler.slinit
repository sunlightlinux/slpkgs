# kube-scheduler -- Kubernetes scheduler (kubernetes).
# Not started by default; enable with: slinitctl enable kube-scheduler
# Options: /etc/kubernetes/config and /etc/kubernetes/scheduler.
type = process
command = /usr/libexec/slinit/kube-scheduler
run-as = kube:kube
depends-on: network.target
restart = true
# Output: stdout goes to the journal; stderr is discarded, as the
# runit run script discarded it.
log-type = journal

# spreed-webrtc-server -- WebRTC conferencing server (spreed-webrtc). Not
# started by default; enable with: slinitctl enable spreed-webrtc-server
type = process
command = /usr/bin/spreed-webrtc-server -c /etc/spreed/webrtc.conf
run-as = _spreed_webrtc:_spreed_webrtc
depends-on: network.target
restart = true
log-type = journal

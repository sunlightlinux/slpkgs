# discosrv -- Syncthing discovery server (syncthing-discosrv). Not started
# by default; enable with: slinitctl enable discosrv
# Options: DISCO_ARGS in /etc/conf.d/discosrv.
type = process
command = /usr/libexec/slinit/discosrv
run-as = _discosrv
depends-on: network.target
restart = true
log-type = journal

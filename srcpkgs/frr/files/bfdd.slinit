# bfdd -- FRRouting bfdd daemon (frr). Not started by default; enable
# with: slinitctl enable bfdd
# Options: ARGS in /etc/conf.d/bfdd. Routing is part of the network
# setup, so it does not depend on or wait for network.target.
type = process
command = /usr/libexec/slinit/bfdd
ready-check-command = /usr/bin/vtysh -c exit -d bfdd
depends-on: local.target
# The runit run script checked staticd first (sv check staticd).
depends-on: staticd
restart = true
log-type = journal

# bgpd -- FRRouting bgpd daemon (frr). Not started by default; enable
# with: slinitctl enable bgpd
# Options: ARGS in /etc/conf.d/bgpd. Routing is part of the network
# setup, so it does not depend on or wait for network.target.
type = process
command = /usr/libexec/slinit/bgpd
ready-check-command = /usr/bin/vtysh -c exit -d bgpd
depends-on: local.target
# The runit run script checked staticd first (sv check staticd).
depends-on: staticd
restart = true
log-type = journal

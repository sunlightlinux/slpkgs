# sharpd -- FRRouting sharpd daemon (frr). Not started by default; enable
# with: slinitctl enable sharpd
# Options: ARGS in /etc/conf.d/sharpd. Routing is part of the network
# setup, so it does not depend on or wait for network.target.
type = process
command = /usr/libexec/slinit/sharpd
ready-check-command = /usr/bin/vtysh -c exit -d sharpd
depends-on: local.target
# The runit run script checked staticd first (sv check staticd).
depends-on: staticd
restart = true
log-type = journal

# staticd -- FRRouting staticd daemon (frr). Not started by default; enable
# with: slinitctl enable staticd
# Options: ARGS in /etc/conf.d/staticd. Routing is part of the network
# setup, so it does not depend on or wait for network.target.
type = process
command = /usr/libexec/slinit/staticd
ready-check-command = /usr/bin/vtysh -c exit -d staticd
depends-on: local.target
# The runit run script checked zebra first (sv check zebra).
depends-on: zebra
restart = true
log-type = journal

#!/bin/sh
# Void's runit run script: builds the --allow list from
# /etc/distcc/clients.allow and runs distccd in the foreground, dropping
# to nobody itself.
set -u
PROG="/usr/bin/distccd"
USER="nobody"
OPTIONS="--no-detach"
OPTIONS="$OPTIONS --daemon"
OPTIONS="$OPTIONS --user $USER"
ALLOW_FILE=/etc/distcc/clients.allow
ALLOW_OPTIONS=
if [ -f "$ALLOW_FILE" ]; then
        ALLOW_OPTIONS=$(/usr/bin/sed -e 's/#.*$//' -e '/^\s*$/d' -e 's/^/--allow /' < $ALLOW_FILE)
fi
if [ -z "$ALLOW_OPTIONS" ]; then
        # Default to allow localhost
        ALLOW_OPTIONS="--allow 127.0.0.1"
fi
OPTIONS="$OPTIONS $ALLOW_OPTIONS"
exec $PROG $OPTIONS

# distccd -- distributed C/C++ compilation server (distcc). Not started
# by default; enable with: slinitctl enable distccd
# Allowed clients: /etc/distcc/clients.allow (default 127.0.0.1 only).
type = process
command = /usr/libexec/slinit/distccd
depends-on: network.target
restart = true
log-type = journal

# ddclient -- updates dynamic DNS entries (ddclient), configured by
# /etc/ddclient/ddclient.conf. Not started by default; enable with:
#     slinitctl enable ddclient
# Options: OPTS in /etc/conf.d/ddclient.
type = process
command = /usr/libexec/slinit/ddclient
depends-on: network.target
restart = true
log-type = journal

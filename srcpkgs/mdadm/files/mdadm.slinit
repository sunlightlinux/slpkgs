# mdadm -- monitors md RAID arrays and reports events to syslog (and to
# MAILADDR in /etc/mdadm.conf, if set) (mdadm). Not started by default;
# enable with: slinitctl enable mdadm
type = process
command = /usr/bin/mdadm --monitor --scan --syslog
depends-on: local.target
restart = true
log-type = journal

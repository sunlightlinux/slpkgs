# xl2tpd -- Layer 2 Tunnelling Protocol daemon (xl2tpd), in the
# foreground (-D). Not started by default; enable with:
#     slinitctl enable xl2tpd
# Options: OPTS in /etc/conf.d/xl2tpd (default:
# -c /etc/xl2tpd/xl2tpd.conf).
type = process
command = /usr/libexec/slinit/xl2tpd
depends-on: network.target
restart = true
log-type = journal

# incus -- incusd, the system container and virtual machine manager
# (incus). Not started by default; enable with: slinitctl enable incus
# Options: OPTS in /etc/conf.d/incus (default --verbose).
type = process
command = /usr/libexec/slinit/incus
ready-check-command = /usr/bin/incus config show
stop-command = /usr/bin/incus admin shutdown
depends-on: local.target
waits-for: network.target
restart = true
log-type = journal

# zeek -- Zeek network traffic analyser (zeek), on interface INTF (default
# eth0), writing its logs to ZEEKLOGDIR (default /var/log/zeek). Not
# started by default; enable with: slinitctl enable zeek
# Options: INTF, ZEEKLOGDIR and ZEEKPOLICY in /etc/conf.d/zeek.
type = process
command = /usr/libexec/slinit/zeek
depends-on: network.target
restart = true
log-type = journal

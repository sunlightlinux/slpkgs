# dropbear -- small SSH server (dropbear). Not started by default; enable
# with: slinitctl enable dropbear
# Options: OPTS in /etc/conf.d/dropbear (default -F -R: foreground, host
# keys generated on first connection).
type = process
command = /usr/libexec/slinit/dropbear
depends-on: local.target
depends-on: network.target
restart = true
log-type = journal

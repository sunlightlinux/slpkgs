# iptables -- loads the IPv4 firewall rules from /etc/iptables/iptables.rules
# (iptables). Not started by default; enable with: slinitctl enable iptables
# Stopping it flushes the rules. It must be in place before the network is
# used, so it does not depend on or wait for network.target.
type = scripted
command = /usr/libexec/slinit/iptables
stop-command = /usr/libexec/iptables-flush
depends-on: local.target
# Ordered before the network setup when both start.
before: pre-network.target

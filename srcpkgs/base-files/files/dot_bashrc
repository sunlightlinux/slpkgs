# .bashrc

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
# user@host orange for root, bright blue for a normal user (same rule as
# /etc/profile.d/sunlight-prompt.sh), so a root shell is obvious at a glance.
if [ "$(id -u)" -eq 0 ]; then
	_sl_uc='38;5;208'
else
	_sl_uc='94'
fi
PS1='\[\e[32m\]┌──(\[\e['"$_sl_uc"';1m\]\u\[\e['"$_sl_uc"'m\]@\[\e['"$_sl_uc"'m\]\h\[\e[0;32m\])-[\[\e[38;5;46;1m\]\w\[\e[0;32m\]] [\[\e[32m\]$?\[\e[32m\]]\n\[\e[32m\]╰─\[\e['"$_sl_uc"';1m\]\$ \[\e[0m\]'
unset _sl_uc

# pqueryd -- PopCorn statistics query server (PopCorn-Server). Not
# started by default; enable with: slinitctl enable pqueryd
# Options: PORT and DATA_DIR in /etc/conf.d/pqueryd.
type = process
command = /usr/libexec/slinit/pqueryd
run-as = _popcorn:_popcorn
depends-on: network.target
restart = true
log-type = journal

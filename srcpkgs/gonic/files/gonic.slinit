# gonic -- Subsonic-compatible music streaming server (gonic). Not started
# by default; enable with: slinitctl enable gonic
# Options: OPTS and the GONIC_* paths in /etc/conf.d/gonic, read by the
# helper as _gonic.
type = process
command = /usr/libexec/slinit/gonic
run-as = _gonic
depends-on: network.target
restart = true
log-type = journal

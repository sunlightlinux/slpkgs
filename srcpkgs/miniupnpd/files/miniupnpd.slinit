# miniupnpd -- UPnP IGD and NAT-PMP daemon (miniupnpd). Not started by
# default; enable with: slinitctl enable miniupnpd
# Options: OPTS in /etc/conf.d/miniupnpd (default
# -f /etc/miniupnpd/miniupnpd.conf).
type = process
command = /usr/libexec/slinit/miniupnpd
depends-on: network.target
restart = true
log-type = journal

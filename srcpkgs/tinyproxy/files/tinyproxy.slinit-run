#!/bin/sh
# Void's runit run script, with its conf moved to /etc/conf.d, absolute
# paths, and chpst -1 as exec 1>&-.
set -u
OPTS=
[ -r /etc/conf.d/tinyproxy ] && . /etc/conf.d/tinyproxy
/usr/bin/install -d -m 0755 -o _tinyproxy -g _tinyproxy /run/tinyproxy
exec 1>&-
exec /usr/bin/tinyproxy -d $OPTS

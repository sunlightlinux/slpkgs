# cronie -- runs crontabs (cronie). Started by default (vslinit enable).
# Same invocation as Void's runit service, with mail off, as no mail transport
# is installed by default. Named cronie, as Void's runit service is; it was
# crond in slinit-services before 20261108_13.
type = process
command = /usr/bin/cronie-crond -n -s -m off
depends-on: local.target
restart = true

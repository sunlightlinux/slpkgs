# matterircd -- IRC gateway to Mattermost and Slack (matterircd). Not
# started by default; enable with: slinitctl enable matterircd
# Configuration file: CONFIG in /etc/conf.d/matterircd (default:
# /etc/matterircd/matterircd.toml).
type = process
command = /usr/libexec/slinit/matterircd
run-as = _matterircd:_matterircd
working-dir = /var/lib/matterircd
depends-on: network.target
restart = true
log-type = journal

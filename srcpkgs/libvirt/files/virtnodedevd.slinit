# virtnodedevd -- libvirt node device driver daemon (libvirt).
# Not started by default; enable with: slinitctl enable virtnodedevd
# Options: OPTS in /etc/conf.d/virtnodedevd.
type = process
command = /usr/libexec/slinit/virtnodedevd
depends-on: dbus
depends-on: local.target
restart = true
log-type = journal

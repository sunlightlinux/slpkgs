# virtinterfaced -- libvirt host interface driver daemon (libvirt).
# Not started by default; enable with: slinitctl enable virtinterfaced
# Options: OPTS in /etc/conf.d/virtinterfaced.
type = process
command = /usr/libexec/slinit/virtinterfaced
depends-on: dbus
depends-on: local.target
restart = true
log-type = journal

# virtsecretd -- libvirt secret driver daemon (libvirt).
# Not started by default; enable with: slinitctl enable virtsecretd
# Options: OPTS in /etc/conf.d/virtsecretd.
type = process
command = /usr/libexec/slinit/virtsecretd
depends-on: dbus
depends-on: local.target
restart = true
log-type = journal

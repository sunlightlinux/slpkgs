#!/bin/sh
# Void's runit run script, with its conf moved to /etc/conf.d and chpst -u
# replaced by setpriv.
set -u
USER=
GROUP=
HOME=

[ -r /etc/conf.d/gokapi ] && . /etc/conf.d/gokapi

: ${USER:=_gokapi}
: ${GROUP:=_gokapi}
: ${HOME:=/var/lib/gokapi}

export USER GROUP HOME

cd "${HOME}" && exec /usr/bin/setpriv --reuid "${USER}" --regid "${GROUP}" \
	--clear-groups -- /usr/bin/gokapi

# alertmanager -- handles alerts sent by Prometheus (alertmanager). Not
# started by default; enable with: slinitctl enable alertmanager
# Options: USER, CONF_FILE, CONF_FLAG, WRKDIR and ARGS in
# /etc/conf.d/alertmanager. The helper runs as root, as the user is read
# from that file, and drops to it through setpriv.
type = process
command = /usr/libexec/slinit/alertmanager
depends-on: network.target
restart = true
log-type = journal

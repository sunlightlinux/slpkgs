# mouseemu -- emulates mouse buttons and the wheel from the keyboard
# (mouseemu), in the foreground (-nofork). Not started by default;
# enable with: slinitctl enable mouseemu
# Options: MID_CLICK, RIGHT_CLICK, SCROLL, TYPING_BLOCK in
# /etc/conf.d/mouseemu.
type = process
command = /usr/libexec/slinit/mouseemu
depends-on: local.target
restart = true
log-type = journal

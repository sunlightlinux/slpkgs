# dkimproxy_out -- DKIM SMTP proxy, signing outgoing mail
# (dkimproxy). Not started by default; enable with:
#     slinitctl enable dkimproxy_out
type = process
command = /usr/bin/dkimproxy.out --conf_file=/etc/dkimproxy_out.conf
run-as = _dkim:_dkim
depends-on: network.target
restart = true
log-type = journal

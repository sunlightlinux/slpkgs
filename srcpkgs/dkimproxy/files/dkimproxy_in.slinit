# dkimproxy_in -- DKIM SMTP proxy, verifying incoming mail
# (dkimproxy). Not started by default; enable with:
#     slinitctl enable dkimproxy_in
type = process
command = /usr/bin/dkimproxy.in --conf_file=/etc/dkimproxy_in.conf
run-as = _dkim:_dkim
depends-on: network.target
restart = true
log-type = journal
